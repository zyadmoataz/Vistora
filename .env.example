# Wix Headless Storefront Identifiers (obtain from your Wix Headless Dashboard)
NEXT_PUBLIC_WIX_CLIENT_ID=your-wix-oauth-client-id
NEXT_PUBLIC_WIX_APP_ID=your-wix-stores-app-id
FEATURED_PRODUCTS_CATEGORY_ID=your-featured-collection-id

# Optional: set to "false" in strict production deployments to require live Wix OAuth authentication
NEXT_PUBLIC_DEMO_MODE=true
